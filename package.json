{
  "name": "audience-activation-platform",
  "version": "0.1.0",
  "private": true,
  "description": "First-Party Audience Activation & Retargeting Platform \u2014 segment first-party customers and activate consented audiences to Meta, Google and future destinations.",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @aap/web dev",
    "dev:worker": "pnpm --filter @aap/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @aap/db migrate",
    "db:reset": "pnpm --filter @aap/db reset",
    "db:seed": "pnpm --filter @aap/core seed",
    "db:codegen": "pnpm --filter @aap/db codegen",
    "db:local": "pnpm --filter @aap/db local",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,sql,yml,yaml}\"",
    "start": "node scripts/boot.mjs web",
    "start:worker": "node scripts/boot.mjs worker"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "dotenv": "^16.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "msgpackr-extract"
    ],
    "overrides": {
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0"
    }
  }
}
